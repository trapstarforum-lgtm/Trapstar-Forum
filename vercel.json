{
  "version": 2,
  "public": true,
  "rewrites": [
    { "source": "/((?!api/|assets/|css/|js/|favicon.ico).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "includeFiles": "{lib/**,server.js,public/assets/logo.png}"
    }
  },
  "env": {
    "PUBLIC_URL": "https://trapstar-forum.lol"
  }
}
